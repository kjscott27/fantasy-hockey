# From your ESPN team page URL: https://fantasy.espn.com/hockey/team?leagueId=XXXX&teamId=Y
ESPN_LEAGUE_ID=
# Optional: auto-detected from your SWID if left blank
ESPN_TEAM_ID=
# ESPN names seasons by the year they end: 2026-27 = 2027
ESPN_SEASON=2027
# Cookies from fantasy.espn.com while logged in (DevTools > Application > Cookies).
# Keep the curly braces on SWID. These grant account access - never commit this file.
ESPN_S2=
ESPN_SWID={00000000-0000-0000-0000-000000000000}

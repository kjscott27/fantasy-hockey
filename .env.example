# From your ESPN team page URL: https://fantasy.espn.com/hockey/team?leagueId=XXXX&teamId=Y
ESPN_LEAGUE_ID=
# Optional: auto-detected from your SWID if left blank
ESPN_TEAM_ID=
# ESPN names seasons by the year they end: 2026-27 = 2027
ESPN_SEASON=2027
# Cookies from fantasy.espn.com while logged in (DevTools > Application > Cookies).
# Keep the curly braces on SWID. These grant account access - never commit this file.
ESPN_S2=
ESPN_SWID={00000000-0000-0000-0000-000000000000}

# Optional: email after scheduled runs (npm run scheduled). Leave blank to turn off.
# Use a DEDICATED sender Gmail, not your main account: an App Password can read that
# account's whole inbox, so a leak should only expose an empty one. The sender needs
# 2-Step Verification on; create the App Password at myaccount.google.com/apppasswords.
NOTIFY_GMAIL_USER=
NOTIFY_GMAIL_APP_PASSWORD=
# Where the emails go (your main inbox)
NOTIFY_EMAIL_TO=
# Optional: link to the report in emails, e.g. https://<pi>.<tailnet>.ts.net/latest.html
REPORT_URL=
